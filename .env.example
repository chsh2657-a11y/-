# 쿠팡 파트너스 > 추가기능 > Open API 에서 발급받은 키 (이 파일을 .env.local 로 복사해서 값을 채우세요)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# (선택) 대시보드 비밀번호. 설정하면 비밀번호를 입력해야 리포트를 볼 수 있습니다.
DASHBOARD_PASSWORD=

# (선택) 1시간당 쿠팡 API 최대 호출 수. 쿠팡은 과다 호출 시 API를 일시 정지하므로 낮게 유지하세요. 기본 20
COUPANG_MAX_CALLS_PER_HOUR=20

# (선택) 이번 달 데이터 캐시 유지 시간(분). 지난 달 데이터는 24시간 캐시됩니다. 기본 30
COUPANG_CACHE_MINUTES=30

# (선택) 캐시 저장 폴더. 기본 ./.cache/coupang
COUPANG_CACHE_DIR=
